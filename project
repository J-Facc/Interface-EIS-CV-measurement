## 6. comparison/metrics.py — fonctions à implémenter

```python
import numpy as np
from scipy.stats import t, ttest_rel
from sklearn.utils import resample

def compute_sigma_intra(predictions: np.ndarray) -> float:
    """
    Écart-type des prédictions sur les réplicats d'une même électrode.
    predictions : shape (n_replicats,), en log10([c])
    Retourne sigma en décades.
    """

def compute_sigma_inter(mean_e1: float, mean_e2: float) -> float:
    """
    Différence absolue entre les prédictions moyennes des deux électrodes.
    Mesure la variabilité de fonctionnalisation résiduelle.
    Retourne delta en décades.
    """

def compute_rmsep(y_pred: np.ndarray, y_true: np.ndarray) -> float:
    """
    Root Mean Square Error of Prediction.
    y_pred, y_true : en log10([c])
    Retourne RMSEP en décades.
    """

def compute_bias(y_pred: np.ndarray, y_true: np.ndarray) -> float:
    """
    Biais moyen signé : mean(y_pred - y_true).
    Positif = surestimation systématique.
    Retourne biais en décades.
    """

def compute_rpd(y_true: np.ndarray, rmsep: float) -> float:
    """
    Ratio of Performance to Deviation = std(y_true) / rmsep.
    RPD > 3 = acceptable, > 5 = excellent.
    """

def compute_ci95_bootstrap(
    predictions: np.ndarray,
    n_bootstrap: int = 1000
) -> tuple[float, float]:
    """
    Intervalle de confiance à 95% par bootstrap sur les réplicats.
    Retourne (borne_inf, borne_sup) en log10([c]).
    """

def compute_rmsecv_logo(
    X: np.ndarray,
    y: np.ndarray,
    groups: np.ndarray,
    model_fn  # callable : fit(X_train, y_train) -> predict(X_test)
) -> float:
    """
    RMSECV par Leave-One-Group-Out (leave-one-concentration-out).
    groups : array d'entiers, même valeur pour les réplicats d'une même concentration.
    """

def diebold_mariano_test(
    errors_a: np.ndarray,
    errors_b: np.ndarray
) -> tuple[float, float]:
    """
    Test de Diebold-Mariano sur erreurs au carré.
    Retourne (statistique, p_value).
    H0 : les deux méthodes ont la même performance.
    """

def compute_normalization_reduction(
    sigma_inter_raw: float,
    sigma_inter_norm: float
) -> float:
    """
    Facteur de réduction de variabilité inter-électrode par la normalisation.
    Retourne sigma_inter_raw / sigma_inter_norm.
    """
```

