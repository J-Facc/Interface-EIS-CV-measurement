<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>EIS Analyzer — Référence Maintenance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --ink:      #0f1117;
      --paper:    #f7f4ef;
      --card:     #ffffff;
      --border:   #e2ddd6;
      --accent:   #1a56db;
      --warn:     #c2410c;
      --ok:       #15803d;
      --muted:    #6b7280;
      --mono-bg:  #f0ede8;
      --serif:    'Lora', Georgia, serif;
      --sans:     'Syne', sans-serif;
      --mono:     'JetBrains Mono', monospace;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      background: var(--paper);
      color: var(--ink);
      font-family: var(--serif);
      line-height: 1.75;
    }

    /* ── Layout ── */
    .page {
      display: grid;
      grid-template-columns: 240px 1fr;
      min-height: 100vh;
    }

    /* ── Sidebar nav ── */
    nav {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      background: var(--ink);
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-logo {
      font-family: var(--sans);
      font-size: 1rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin-bottom: 2rem;
      line-height: 1.2;
    }

    .nav-logo span {
      display: block;
      font-size: 0.65rem;
      font-weight: 400;
      color: #6b7280;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-top: 0.3rem;
      font-family: var(--mono);
    }

    .nav-section {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #4b5563;
      margin-top: 1.5rem;
      margin-bottom: 0.4rem;
      padding-left: 0.5rem;
    }

    nav a {
      display: block;
      font-family: var(--sans);
      font-size: 0.8rem;
      color: #9ca3af;
      text-decoration: none;
      padding: 0.35rem 0.5rem;
      border-radius: 3px;
      transition: color 0.15s, background 0.15s;
      font-weight: 400;
    }

    nav a:hover {
      color: #ffffff;
      background: #1f2937;
    }

    nav a.active {
      color: #ffffff;
      background: #1a56db22;
      border-left: 2px solid #1a56db;
    }

    /* ── Main content ── */
    main {
      padding: 4rem 3rem 6rem;
      max-width: 860px;
    }

    /* ── Sections ── */
    .section {
      margin-bottom: 4rem;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .section.visible {
      opacity: 1;
      transform: none;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .section-num {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: var(--muted);
      min-width: 2rem;
    }

    h2 {
      font-family: var(--sans);
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--ink);
      letter-spacing: -0.02em;
    }

    h3 {
      font-family: var(--sans);
      font-size: 1rem;
      font-weight: 600;
      color: var(--ink);
      margin: 1.5rem 0 0.75rem;
    }

    p {
      font-size: 0.95rem;
      color: #374151;
      margin-bottom: 1rem;
    }

    /* ── Code blocks ── */
    pre {
      background: var(--mono-bg);
      border: 1px solid var(--border);
      padding: 1.25rem 1.5rem;
      font-family: var(--mono);
      font-size: 0.78rem;
      line-height: 1.7;
      overflow-x: auto;
      color: var(--ink);
      margin: 1rem 0;
    }

    code {
      font-family: var(--mono);
      font-size: 0.82rem;
      background: var(--mono-bg);
      padding: 0.1rem 0.35rem;
      border-radius: 2px;
      color: var(--accent);
    }

    pre code {
      background: none;
      padding: 0;
      color: inherit;
      font-size: inherit;
    }

    /* ── Tables ── */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      margin: 1rem 0 1.5rem;
    }

    th {
      font-family: var(--sans);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      padding: 0.6rem 0.75rem;
      text-align: left;
      border-bottom: 2px solid var(--border);
      background: var(--paper);
    }

    td {
      padding: 0.6rem 0.75rem;
      border-bottom: 1px solid var(--border);
      color: #374151;
      vertical-align: top;
    }

    td:first-child {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--accent);
      white-space: nowrap;
    }

    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #faf9f7; }

    /* ── Callouts ── */
    .callout {
      border-left: 3px solid var(--accent);
      background: #eff6ff;
      padding: 0.75rem 1rem;
      margin: 1rem 0;
      font-size: 0.88rem;
      color: #1e40af;
    }

    .callout.warn {
      border-color: var(--warn);
      background: #fff7ed;
      color: #9a3412;
    }

    .callout.ok {
      border-color: var(--ok);
      background: #f0fdf4;
      color: #166534;
    }

    .callout strong {
      font-family: var(--sans);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 0.25rem;
    }

    /* ── File tree ── */
    .tree {
      font-family: var(--mono);
      font-size: 0.78rem;
      line-height: 1.9;
      background: var(--mono-bg);
      border: 1px solid var(--border);
      padding: 1.5rem;
      overflow-x: auto;
    }

    .tree .dir   { color: var(--accent); font-weight: 500; }
    .tree .file  { color: var(--ink); }
    .tree .note  { color: var(--muted); }
    .tree .warn  { color: var(--warn); font-weight: 500; }

    /* ── Pipeline steps ── */
    .pipeline {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 1rem 0;
    }

    .pipe-row {
      display: flex;
      align-items: stretch;
      gap: 0;
    }

    .pipe-connector {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 32px;
      flex-shrink: 0;
    }

    .pipe-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      margin-top: 1rem;
      flex-shrink: 0;
    }

    .pipe-line {
      width: 1px;
      flex: 1;
      background: var(--border);
      margin: 2px 0;
    }

    .pipe-card {
      flex: 1;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 0.75rem 1rem;
      margin-bottom: 4px;
    }

    .pipe-label {
      font-family: var(--sans);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 0.2rem;
    }

    .pipe-detail {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: var(--muted);
    }

    /* ── Error table highlight ── */
    .err-row td:first-child { color: var(--warn); }

    /* ── Hero ── */
    .hero {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid var(--ink);
    }

    .hero-eyebrow {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.75rem;
    }

    .hero h1 {
      font-family: var(--sans);
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--ink);
      line-height: 1.1;
      margin-bottom: 1rem;
    }

    .hero h1 em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--muted);
    }

    .hero-meta a {
      color: var(--accent);
      text-decoration: none;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .page { grid-template-columns: 1fr; }
      nav { position: static; height: auto; }
      main { padding: 2rem 1.5rem; }
    }
  </style>
</head>
<body>

<div class="page">

<!-- ── NAV ── -->
<nav>
  <div class="nav-logo">
    EIS Analyzer
    <span>Référence · Maintenance</span>
  </div>

  <div class="nav-section">Vue d'ensemble</div>
  <a href="#objectif">Objectif</a>
  <a href="#architecture">Architecture</a>
  <a href="#flux">Flux de données</a>

  <div class="nav-section">Modules</div>
  <a href="#core">core/</a>
  <a href="#fits">fits/</a>
  <a href="#plotting">plotting/</a>
