├── <span class="file">.version</span>                  <span class="note">← SHA GitHub du dernier update local</span>
│
├── <span class="dir">config/</span>
│   └── <span class="file">default.yaml</span>           <span class="note">← paramètres physiques et de fit</span>
│
├── <span class="dir">core/</span>                      <span class="note">← logique métier (JAMAIS d'import Streamlit)</span>
│   ├── <span class="warn">__init__.py</span>
│   ├── <span class="file">models.py</span>              <span class="note">← EISSpectrum, FitResult, EISSession</span>
